
model {

  phi ~ dbeta(1,1)
  p ~ dbeta(1,1)
  gamma[1] ~ dbeta(1,1)
  gamma[2] ~ dbeta(1,1)  
  pstar <- 1 - (1 - p)^(n.sec)
  
  
  for (i in 1:I){

    # robust design capture-recapture likelihood
    for (t in (f[i]+1):n.years){
      z[i,t] ~ dbern(phi * z[i,t-1])
      a[i,t] ~ dbern(z[i,t] * gamma[a[i,t-1]+1])
      
      for (j in 1:n.sec){
        r[i,t,j] ~ dbern(a[i,t] * p)
      }
    }

   }
  
  
}

